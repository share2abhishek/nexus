{
  "name": "nexus",
  "version": "2.0.0",
  "description": "NEXUS — AI Digital Marketing Platform",
  "main": "electron/main.js",
  "scripts": {
    "start":          "node server/index.js",
    "dev":            "nodemon server/index.js",
    "electron":       "electron .",
    "electron:dev":   "NODE_ENV=development electron .",
    "icons":          "node build/create-icons.js",
    "rebuild":        "npx @electron/rebuild",
    "dist":           "npm run icons && electron-builder --win --x64",
    "dist:dir":       "npm run icons && electron-builder --win --x64 --dir",
    "dist:all":       "npm run icons && electron-builder --win --mac --linux --x64",
    "postinstall":    "npx @electron/rebuild --force 2>nul; exit 0"
  },
  "dependencies": {
    "@anthropic-ai/sdk":        "^0.30.0",
    "@google/generative-ai":    "^0.24.1",
    "axios":                    "^1.7.2",
    "bcryptjs":                 "^3.0.3",
    "better-sqlite3":           "^9.6.0",
    "connect-sqlite3":          "^0.9.15",
    "cors":                     "^2.8.5",
    "csv-parse":                "^5.5.6",
    "dotenv":                   "^16.4.5",
    "express":                  "^4.19.2",
    "express-session":          "^1.18.0",
    "form-data":                "^4.0.0",
    "multer":                   "^1.4.5-lts.1",
    "node-cron":                "^3.0.3",
    "nodemailer":               "^6.10.1",
    "open":                     "^10.1.0",
    "passport":                 "^0.7.0",
    "passport-facebook":        "^3.0.0",
    "passport-linkedin-oauth2": "^2.0.0",
    "passport-pinterest":       "^1.0.0",
    "passport-twitter":         "^1.0.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron":          "^35.0.0",
    "electron-builder":  "^26.0.0",
    "nodemon":           "^3.1.3",
    "sharp":             "^0.33.5",
    "png-to-ico":        "^2.1.8"
  },
  "build": {
    "appId":       "com.nexus.marketing",
    "productName": "NEXUS",
    "copyright":   "NEXUS AI Digital Marketing Platform",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "routes/**/*",
      "services/**/*",
      "middleware/**/*",
      "public/**/*",
      "install/**/*",
      ".env.example",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!dist-app/**/*",
      "!**/*.log"
    ],
    "extraResources": [
      { "from": "public", "to": "public", "filter": ["**/*"] }
    ],
    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon":          "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick":                      false,
      "allowElevation":                true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon":                 "build/icon.ico",
      "uninstallerIcon":               "build/icon.ico",
      "installerHeaderIcon":           "build/icon.ico",
      "createDesktopShortcut":         true,
      "createStartMenuShortcut":       true,
      "shortcutName":                  "NEXUS Marketing",
      "runAfterFinish":                true,
      "installerLanguages":            ["en_US"],
      "license":                       "LICENSE.txt",
      "artifactName":                  "NEXUS-Setup-${version}.exe",
      "include":                       "build/installer.nsh"
    },
    "portable": {
      "artifactName": "NEXUS-Portable-${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "icon":   "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon":   "build/icon.png",
      "category": "Office"
    },
    "publish":  null,
    "npmRebuild": false,
    "buildDependenciesFromSource": false
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
