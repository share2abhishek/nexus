PORT=3000
SESSION_SECRET=nexus-super-secret-change-this-in-production

# ─── AI Content Generation ─────────────────────────────────────────────────────
# Google Gemini (primary, free tier) — https://aistudio.google.com
GOOGLE_AI_KEY=

# Anthropic Claude (fallback) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ─── AI Image Generation ───────────────────────────────────────────────────────
# Stability AI (SDXL) — free credits at https://stability.ai
STABILITY_API_KEY=

# OpenAI DALL-E 3 — https://platform.openai.com
OPENAI_API_KEY=

# ─── AI Video Generation ───────────────────────────────────────────────────────
# Luma Dream Machine — https://lumalabs.ai/dream-machine/api
LUMA_API_KEY=

# Runway Gen-3 — https://runwayml.com/api
RUNWAY_API_KEY=

# ─── LinkedIn ──────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:3000/auth/linkedin/callback

# ─── Facebook + Instagram ──────────────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback

# ─── Pinterest ─────────────────────────────────────────────────────────────────
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_CALLBACK_URL=http://localhost:3000/auth/pinterest/callback

# ─── Twitter / X ───────────────────────────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_CALLBACK_URL=http://localhost:3000/auth/twitter/callback

# ─── Google OAuth (YouTube + Google Business Profile) ──────────────────────────
# One app covers both — enable YouTube Data API v3 + My Business API in Cloud Console
# https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ─── TikTok ────────────────────────────────────────────────────────────────────
# https://developers.tiktok.com/apps
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_CALLBACK_URL=http://localhost:3000/auth/tiktok/callback

# ─── Email Marketing (SMTP) ────────────────────────────────────────────────────
# Gmail: use an App Password — https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your@gmail.com
SMTP_FROM_NAME=Your Brand Name

# ─── Ollama Local AI (PRIMARY — free, private, no API key needed) ─────────────
# NEXUS guides you through setup on first run. Install from
# https://ollama.com/download then it pulls a model for you (or run manually:
# ollama pull llama3.2). Cloud keys above are used only as fallback.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Local Content Folder ──────────────────────────────────────────────────────
CONTENT_FOLDER=D:/social

# ─── Database Edition ──────────────────────────────────────────────────────────
# Database edition: sqlite (default desktop) or pg (cloud)
DB_CLIENT=sqlite
# Required when DB_CLIENT=pg (Azure and most cloud Postgres need ?sslmode=require):
# DATABASE_URL=postgres://user:pass@host:5432/nexus?sslmode=require

# ─── Server edition ───────────────────────────────────────────────────────────
# Turns on features that run all the time (SEO autopilot). Also on when DB_CLIENT=pg.
# NEXUS_MODE=server
# The service's public web address, used in emailed links (e.g. https://app.radixile.com)
# APP_URL=
# Radixile staff who run the service: they become platform admins once their email
# is confirmed (comma-separated). Customers who sign up are never admins.
# PLATFORM_ADMIN_EMAILS=
# Mail server for account emails (confirm email, reset password, invitations).
# Falls back to the SMTP_* settings above when not set.
# PLATFORM_SMTP_HOST=
# PLATFORM_SMTP_PORT=587
# PLATFORM_SMTP_USER=
# PLATFORM_SMTP_PASS=
# PLATFORM_SMTP_FROM=noreply@radixile.com
# PLATFORM_SMTP_FROM_NAME=Social-Nexus
# Free key from Google Cloud (PageSpeed Insights API) for page-speed checks;
# without it Google's small shared allowance is often used up.
# PAGESPEED_API_KEY=
